{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parsa:attestara:input:1",
  "title": "Attestara release-evidence input v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "tool": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "verification": {
      "const": "unverified"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 104857600,
            "$comment": "The typed Go reader requires a plain integer token, without decimal points or exponents."
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          }
        },
        "required": [
          "path",
          "digest",
          "size_bytes",
          "media_type"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "owner",
    "subject_digest",
    "source_revision",
    "tool",
    "tool_version",
    "evidence_digest",
    "policy_digest",
    "verification",
    "files"
  ],
  "$comment": "Go additionally enforces unique file paths, total declared file size <= 104857600 bytes, and manifest membership for all three root digests. JSON wire bytes also have a 100 MiB cap. owner is a descriptive local label, not authenticated identity."
}
