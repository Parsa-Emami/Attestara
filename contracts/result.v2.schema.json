{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parsa:attestara:result:2",
  "title": "Attestara typed result v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed",
        "unverified"
      ]
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "policy_decision": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "verification": {
          "enum": [
            "unverified",
            "rejected"
          ]
        },
        "evidence_references": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "digest"
            ]
          }
        }
      },
      "required": [
        "subject_digest",
        "evidence_digest",
        "policy_digest",
        "policy_decision",
        "verification",
        "evidence_references"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "policy_decision": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_references": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "\\S"
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_json",
            "invalid_input",
            "unsupported_version",
            "limit_exceeded",
            "cancelled",
            "deadline_exceeded",
            "input_unavailable",
            "dependency_unavailable"
          ]
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      },
      "required": [
        "code",
        "field",
        "message"
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "input_digest",
    "engine_version",
    "warnings"
  ],
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "failed"
        }
      },
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "result"
        ]
      }
    },
    {
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "unverified"
          ]
        }
      },
      "required": [
        "result"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "policy_decision": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unverified"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "verification": {
                "const": "unverified"
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "v1 input remains unchanged. policy_digest hashes exact rule bytes. Evidence references have unique paths and must match the associated input root evidence file path/digest; Go/store checks enforce these cross-document invariants. Pass never establishes authenticity."
}
