{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parsa-security:attestara:config:v1",
  "title": "Attestara Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "APP_ENV": {
      "type": "string",
      "enum": [
        "local",
        "test",
        "staging",
        "production"
      ]
    },
    "SERVICE_NAME": {
      "type": "string",
      "const": "attestara"
    },
    "DATABASE_DSN_REF": {
      "type": "string",
      "minLength": 1,
      "description": "Secret/reference URI; never embed production credentials in config."
    },
    "VALKEY_DSN_REF": {
      "type": "string",
      "minLength": 1,
      "description": "Secret/reference URI; never embed production credentials in config."
    },
    "OTEL_EXPORTER_OTLP_ENDPOINT": {
      "type": "string",
      "format": "uri"
    },
    "LOG_LEVEL": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warning",
        "error"
      ]
    },
    "OBJECT_STORE_ENDPOINT": {
      "type": "string",
      "minLength": 1
    },
    "OBJECT_STORE_BUCKET": {
      "type": "string",
      "minLength": 1
    },
    "OPA_URL": {
      "type": "string",
      "minLength": 1
    },
    "RUNNER_PROVIDER": {
      "type": "string",
      "minLength": 1
    },
    "RUNNER_NETWORK_DEFAULT": {
      "type": "string",
      "minLength": 1
    },
    "MAX_SOURCE_ARCHIVE_BYTES": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "APP_ENV",
    "SERVICE_NAME",
    "DATABASE_DSN_REF",
    "VALKEY_DSN_REF",
    "OTEL_EXPORTER_OTLP_ENDPOINT"
  ]
}
