{
  "name": "Attestara",
  "limits": {
    "bundle_max_mib": 100,
    "files_per_bundle": 2000,
    "policy_deadline_seconds": 10
  },
  "domain": {
    "primary": "release-evidence",
    "fields": {
      "subject_digest": "hash",
      "source_revision": "text",
      "tool": "text",
      "tool_version": "text",
      "evidence_digest": "hash",
      "policy_digest": "hash",
      "verification": "text"
    },
    "invariants": [
      "No user source execution",
      "Digest binds subject and outputs",
      "Missing evidence never means pass"
    ]
  },
  "web_application": {
    "deployment_profile": "web-viewer-private-engine",
    "preview_storage": "tab memory only",
    "offline_supported": false
  }
}
