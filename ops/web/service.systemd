[Unit]
Description=Attestara local CLI snapshot service
After=network.target

[Service]
Type=simple
User=attestara-web
Group=attestara-web
WorkingDirectory=/srv/attestara/current
ExecStart=/usr/bin/node scripts/start-local.mjs --store /var/lib/attestara/store --port 4304
StateDirectory=attestara
StateDirectoryMode=0700
KillMode=control-group
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
