{
  "asyncapi": "3.1.0",
  "id": "urn:parsa-security:attestara:events:v1",
  "info": {
    "title": "Attestara Events",
    "version": "1.0.0",
    "description": "Canonical application event contract. Delivery is at-least-once; consumers must be idempotent and deduplicate by event id."
  },
  "defaultContentType": "application/json",
  "channels": {
    "event_source_snapshot_received_v1": {
      "address": "source.snapshot_received.v1",
      "messages": {
        "SourceSnapshotReceivedV1Message": {
          "$ref": "#/components/messages/SourceSnapshotReceivedV1Message"
        }
      }
    },
    "event_scan_requested_v1": {
      "address": "scan.requested.v1",
      "messages": {
        "ScanRequestedV1Message": {
          "$ref": "#/components/messages/ScanRequestedV1Message"
        }
      }
    },
    "event_runner_allocated_v1": {
      "address": "runner.allocated.v1",
      "messages": {
        "RunnerAllocatedV1Message": {
          "$ref": "#/components/messages/RunnerAllocatedV1Message"
        }
      }
    },
    "event_evidence_normalized_v1": {
      "address": "evidence.normalized.v1",
      "messages": {
        "EvidenceNormalizedV1Message": {
          "$ref": "#/components/messages/EvidenceNormalizedV1Message"
        }
      }
    },
    "event_policy_evaluated_v1": {
      "address": "policy.evaluated.v1",
      "messages": {
        "PolicyEvaluatedV1Message": {
          "$ref": "#/components/messages/PolicyEvaluatedV1Message"
        }
      }
    },
    "event_release_gate_decided_v1": {
      "address": "release.gate_decided.v1",
      "messages": {
        "ReleaseGateDecidedV1Message": {
          "$ref": "#/components/messages/ReleaseGateDecidedV1Message"
        }
      }
    },
    "event_runner_destroyed_v1": {
      "address": "runner.destroyed.v1",
      "messages": {
        "RunnerDestroyedV1Message": {
          "$ref": "#/components/messages/RunnerDestroyedV1Message"
        }
      }
    }
  },
  "operations": {
    "send_source_snapshot_received_v1": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/event_source_snapshot_received_v1"
      },
      "messages": [
        {
          "$ref": "#/channels/event_source_snapshot_received_v1/messages/SourceSnapshotReceivedV1Message"
        }
      ]
    },
    "send_scan_requested_v1": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/event_scan_requested_v1"
      },
      "messages": [
        {
          "$ref": "#/channels/event_scan_requested_v1/messages/ScanRequestedV1Message"
        }
      ]
    },
    "send_runner_allocated_v1": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/event_runner_allocated_v1"
      },
      "messages": [
        {
          "$ref": "#/channels/event_runner_allocated_v1/messages/RunnerAllocatedV1Message"
        }
      ]
    },
    "send_evidence_normalized_v1": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/event_evidence_normalized_v1"
      },
      "messages": [
        {
          "$ref": "#/channels/event_evidence_normalized_v1/messages/EvidenceNormalizedV1Message"
        }
      ]
    },
    "send_policy_evaluated_v1": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/event_policy_evaluated_v1"
      },
      "messages": [
        {
          "$ref": "#/channels/event_policy_evaluated_v1/messages/PolicyEvaluatedV1Message"
        }
      ]
    },
    "send_release_gate_decided_v1": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/event_release_gate_decided_v1"
      },
      "messages": [
        {
          "$ref": "#/channels/event_release_gate_decided_v1/messages/ReleaseGateDecidedV1Message"
        }
      ]
    },
    "send_runner_destroyed_v1": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/event_runner_destroyed_v1"
      },
      "messages": [
        {
          "$ref": "#/channels/event_runner_destroyed_v1/messages/RunnerDestroyedV1Message"
        }
      ]
    }
  },
  "components": {
    "messages": {
      "SourceSnapshotReceivedV1Message": {
        "name": "source.snapshot_received.v1",
        "title": "source.snapshot_received.v1",
        "payload": {
          "$ref": "#/components/schemas/EventEnvelope"
        }
      },
      "ScanRequestedV1Message": {
        "name": "scan.requested.v1",
        "title": "scan.requested.v1",
        "payload": {
          "$ref": "#/components/schemas/EventEnvelope"
        }
      },
      "RunnerAllocatedV1Message": {
        "name": "runner.allocated.v1",
        "title": "runner.allocated.v1",
        "payload": {
          "$ref": "#/components/schemas/EventEnvelope"
        }
      },
      "EvidenceNormalizedV1Message": {
        "name": "evidence.normalized.v1",
        "title": "evidence.normalized.v1",
        "payload": {
          "$ref": "#/components/schemas/EventEnvelope"
        }
      },
      "PolicyEvaluatedV1Message": {
        "name": "policy.evaluated.v1",
        "title": "policy.evaluated.v1",
        "payload": {
          "$ref": "#/components/schemas/EventEnvelope"
        }
      },
      "ReleaseGateDecidedV1Message": {
        "name": "release.gate_decided.v1",
        "title": "release.gate_decided.v1",
        "payload": {
          "$ref": "#/components/schemas/EventEnvelope"
        }
      },
      "RunnerDestroyedV1Message": {
        "name": "runner.destroyed.v1",
        "title": "runner.destroyed.v1",
        "payload": {
          "$ref": "#/components/schemas/EventEnvelope"
        }
      }
    },
    "schemas": {
      "EventEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "specversion",
          "id",
          "source",
          "type",
          "time",
          "subject",
          "data"
        ],
        "properties": {
          "specversion": {
            "type": "string",
            "const": "1.0"
          },
          "id": {
            "type": "string",
            "minLength": 16
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "source.snapshot_received.v1",
              "scan.requested.v1",
              "runner.allocated.v1",
              "evidence.normalized.v1",
              "policy.evaluated.v1",
              "release.gate_decided.v1",
              "runner.destroyed.v1"
            ]
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "subject": {
            "type": "string"
          },
          "traceparent": {
            "type": [
              "string",
              "null"
            ]
          },
          "datacontenttype": {
            "type": "string",
            "const": "application/json"
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
  }
}
