# Safe local placeholders only. Copy to .env locally; never commit .env or real credentials.
APP_ENV=local
SERVICE_NAME=attestara
DATABASE_DSN_REF=secret://local/postgres-dsn
VALKEY_DSN_REF=secret://local/valkey-dsn
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
LOG_LEVEL=info
OBJECT_STORE_ENDPOINT=https://object-store.local
OBJECT_STORE_BUCKET=attestara-evidence
OPA_URL=http://127.0.0.1:8181
RUNNER_PROVIDER=podman
RUNNER_NETWORK_DEFAULT=none
MAX_SOURCE_ARCHIVE_BYTES=268435456
